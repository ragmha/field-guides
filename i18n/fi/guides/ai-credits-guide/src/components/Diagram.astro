---
const diagrams = {
  'credit-lifecycle': {
    title: 'Seuraa krediittejä, älä käyttäjäpaikkoja',
    description: 'Business- ja Enterprise-lisenssit rahoittavat yhteistä sisältyvää varantoa. Sen loputtua maksullinen käyttö tarvitsee käytännön luvan ja vapaata tilaa pakottavissa rajoissa. Copilot access ei sisällä varantoa.',
  },
  'layered-guardrails': {
    title: 'Miksi käyttäjä voidaan estää, vaikka krediittejä on jäljellä',
    description: 'Selvitä henkilökohtaisen, kustannuspaikan ja yleisen ULB:n etusijajärjestys. Loppuun käytetty sovellettava ULB estää käyttäjän ennen kuin jäljellä olevat yhteiset krediitit tai mittariperusteinen rahoitus voivat auttaa. Esitetyt määrät ovat hypoteettisia, eivät suositeltuja budjetteja.',
  },
  'cost-center-controls': {
    title: 'Yksi yhteinen varanto, kaksi erilaista tiimirajoitusta',
    description: 'Kustannuspaikan sisältyvän käytön rajoitus rajoittaa sen käyttöä yhteisestä varannosta. Kustannuspaikan mittariperusteinen budjetti rajoittaa lisämaksuja. Kumpikaan ei ole yksityinen lompakko eikä siirto tiimien välillä.',
  },
  'cap-or-continuity': {
    title: 'Sama kynnysarvo, erilainen toiminnallinen lopputulos',
    description: 'Mittariperusteinen pakottava pysäytys estää krediittejä kuluttavan työn rajallaan. Pelkän ilmoituksen lähettävä kynnysarvo antaa työn ja maksujen jatkua omistajan reagoidessa. ULB:t pysäyttävät käytön kummassakin mallissa.',
  },
  'agent-meters': {
    title: 'Yksi agenttityökuorma, kaksi mittaria',
    description: 'Copilot-kooditarkastus kuluttaa erikseen mallin ja tokenien AI-krediittejä sekä Actions-suorittimen minuutteja. Suunnittele ja seuraa molempia; AI-krediittibudjetti ei rajoita Actions-menoja.',
  },
  'rollout-roadmap': {
    title: 'Rakenna toimintamalli ennen automatisointia',
    description: 'Aloita omistajuudesta, yrityksen rajoituksista ja kohdistuksesta. Ota käyttöön kustannuspaikka- ja käyttäjäkohtaiset säännöt, ohjeistus ja reagoinnista vastaavat henkilöt. Etene kuukausittaiseen tarkistukseen ja todennetun prosessin automatisointiin.',
  },
  'operating-loop': {
    title: 'Muuta ilmoitus vastuulliseksi päätökseksi',
    description: 'Tunnista todellinen rajoittava tekijä, ohjaa päätös sen omistajalle, tee hyväksytty muutos, vahvista palautuminen ja arvioi tulos. Ilmoitus ei koskaan yksin oikeuta lisämenoihin.',
  },
  'attribution-pipeline': {
    title: 'Käytöstä vastuulliseen kustannusomistajaan',
    description: 'Kohdista lähteen käyttöraportti omistajille, pidä kohdistamattomat tietueet näkyvissä ja täsmäytä kokonaissummat ja jaksot. Aloita kustannusten esittämisestä; edelleenveloitus vaatii taloushallinnon sopimuksen.',
  },
  'visualisation-map': {
    title: 'Valitse näkymä kysymyksen mukaan',
    description: 'GitHubin laskutustiedot tukevat meno- ja kohdistusnäkymiä. Copilot-käyttömittarit kuvaavat käyttöönottoa ja aktiivisuutta. Seurattujen asiakkaiden telemetria auttaa selvittämään agenttien toimintaa. Käyttöönottomittarit tai telemetria eivät korvaa laskutusta.',
  },
  'grafana-dashboard': {
    title: 'Laskutuskoontinäyttö ilman keksittyjä tietoja',
    description: 'Tämä aloitusmalli määrittää paneelit, lähdekentät ja kysymykset, ei reaaliaikaisia arvoja. Kulutus ja maksut tulevat laskutusvienneistä; viennin tuoreus on oppaan paikallista metatietoa. Asiakastelemetria kuuluu erilliseen vianmääritysnäkymään.',
  },
};

type DiagramName = keyof typeof diagrams;

interface Props {
  name: DiagramName;
}

const { name } = Astro.props;
const { title, description } = diagrams[name];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = `${base}diagrams/${name}.html`;
const headingId = `${name}-heading`;
---

<figure class="diagram-embed" aria-labelledby={headingId}>
  <h3 id={headingId}>{title}</h3>
  <div class="diagram-tools">
    <button class="diagram-zoom" type="button" data-diagram-size aria-pressed="false" aria-controls={`${name}-viewport`} hidden>Suurenna kuva</button>
    <a data-diagram-link={name} href={src} target="_blank" rel="noopener noreferrer">Avaa täysikokoisena</a>
  </div>
  <p class="diagram-hint">Sopii näytölle. Suurenna tekstejä zoomaamalla; vieritä kosketuksella tai nuolinäppäimillä.</p>
  <div id={`${name}-viewport`} class="diagram-scroll" tabindex="0" role="region" aria-label={`${title}. Vieritä vaakasuunnassa tarkastellaksesi suurennettua kuvaa.`}>
    <img class="diagram-light" src={`${base}diagrams/${name}.light.svg`} alt={description} width="640" data-diagram={name} />
    <img class="diagram-dark" src={`${base}diagrams/${name}.dark.svg`} alt={description} width="640" data-diagram={name} />
  </div>
  <figcaption>
    <p>{description}</p>
    <div class="diagram-links">
      <a href={`${base}diagrams/${name}.html`} download>Lataa muokattava HTML</a>
    </div>
  </figcaption>
</figure>

<style>
  .diagram-embed {
    min-width: 0;
    margin: 1rem 0 2rem;
  }

  h3 {
    color: var(--ink);
    font: 650 19px/1.4 var(--font-sans);
    margin: 0 0 16px;
  }

  .diagram-tools { display: flex; align-items: center; gap: 20px; margin-bottom: 12px; font-size: 13px; }
  .diagram-zoom { display: none; color: var(--ink); background: var(--surface); border: 1px solid var(--rule); border-radius: 4px; padding: 10px 14px; cursor: pointer; }
  .diagram-zoom:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .diagram-hint { display: none; }
  @media (max-width: 760px) {
    .diagram-hint { display: block; color: var(--muted); font-size: 12px; margin: 0 0 12px; }
    .diagram-zoom:not([hidden]) { display: inline-block; }
    .diagram-scroll img { min-width: 0; }
    .diagram-zoomed .diagram-scroll img { min-width: 640px; }
  }

  .diagram-scroll {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg);
  }

  img {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
  }

  figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  figcaption p { margin: 0 0 8px; }
  .diagram-links { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .diagram-dark { display: none; }
  :global([data-theme=dark]) .diagram-light { display: none; }
  :global([data-theme=dark]) .diagram-dark { display: block; }
</style>
