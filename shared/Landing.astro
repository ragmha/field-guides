---
// Course-style landing (hero + Parts grid) shared by the Astro guides' start pages.
import { guides } from '../guides.mjs';

interface Props {
  name: string;
  art: { src: string; width: number; height: number };
  alt: string;
  reviewed: string;
  stale: boolean;
  start: string;
  secondary: { href: string; label: string };
  parts: { title: string; description: string; href: string }[];
}
const { name, art, alt, reviewed, stale, start, secondary, parts } = Astro.props;
const guide = guides.find(guide => guide.name === name);
if (!guide) throw new Error(`Unknown guide: ${name}`);
const reviewedOn = new Date(`${reviewed}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<div class="landing">
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-copy">
      <h1 id="landing-title">{guide.title}</h1>
      <p class="landing-intro">{guide.description}</p>
      <p class="landing-note">Sources reviewed {reviewedOn}{stale && ' · review overdue'}</p>
      <div class="landing-actions">
        <a class="landing-button" href={start}>Start now <span aria-hidden="true">→</span></a>
        <a class="landing-button" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
    <img class="landing-art" src={art.src} width={art.width} height={art.height} alt={alt} loading="eager" fetchpriority="high" />
  </section>
  <section class="landing-parts" aria-labelledby="parts-title">
    <h2 id="parts-title">Parts</h2>
    <p>Start with Part 1, or jump to the part you need.</p>
    <ol class="part-grid">
      {parts.map((part, index) => (
        <li class="part-card" id={`part-${index + 1}`}>
          <div class="part-top"><span aria-hidden="true">↖</span><span>{String(index + 1).padStart(2, '0')}</span></div>
          <h3>{part.title}</h3>
          <p>{part.description}</p>
          <a href={part.href}>View chapters<span class="sr-only"> in {part.title}</span> <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
  </section>
</div>
<style>
  .landing{--serif:ui-serif,"New York",Georgia,"Times New Roman",serif;max-width:1180px;margin:0 auto;padding:0 44px}
  .landing-hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;gap:56px;padding:72px 0 64px}
  .landing-copy{min-width:0}
  h1{font:700 clamp(46px,5.6vw,80px)/1.02 var(--serif);letter-spacing:-.02em;color:var(--ink);margin:0 0 26px;max-width:none}
  .landing-intro{font-size:18px;line-height:1.7;color:var(--body);max-width:56ch;margin:0}
  .landing-note{font:italic 16px/1.6 var(--serif);color:var(--muted);margin:16px 0 0}
  .landing-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
  .landing-button{display:inline-flex;align-items:center;gap:18px;padding:13px 24px;border:1px solid var(--ink);color:var(--ink);font-weight:600;text-decoration:none}
  .landing-button+.landing-button{border-color:var(--rule)}
  .landing-button:hover{background:var(--ink);border-color:var(--ink);color:var(--bg);text-decoration:none}
  /* White paper drops out against the page in light mode; inverted ink reads as light lines on dark. */
  .landing-art{display:block;width:100%;height:auto;max-height:560px;object-fit:contain;mix-blend-mode:multiply}
  :global([data-theme=dark]) .landing-art{filter:invert(1) brightness(.82);mix-blend-mode:screen}
  .landing-parts{padding:60px 0 88px;border-top:1px solid var(--rule)}
  h2{font:700 clamp(34px,3.6vw,48px)/1.1 var(--serif);text-align:center;color:var(--ink);margin:0}
  .landing-parts>p{text-align:center;color:var(--muted);margin:10px 0 44px}
  .part-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--rule);border-left:1px solid var(--rule)}
  .part-card{display:flex;flex-direction:column;align-items:center;text-align:center;padding:26px 34px 34px;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);background:var(--surface)}
  .part-top{align-self:stretch;display:flex;justify-content:space-between;font:12px/1 var(--font-mono);color:var(--muted)}
  .part-top>span:first-child{font:18px/1 var(--font-sans)}
  h3{font-size:21px;font-weight:500;line-height:1.35;letter-spacing:-.2px;color:var(--ink);margin:22px 0 12px}
  .part-card p{font-size:15px;line-height:1.7;color:var(--muted);margin:0 0 30px}
  .part-card a{margin-top:auto;color:var(--ink);font-weight:500;text-decoration:none}
  .part-card a:hover{color:var(--link);text-decoration:underline}
  @media(max-width:1000px){.part-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.landing{padding:0 22px}.landing-hero{grid-template-columns:1fr;gap:28px;padding:44px 0 40px}.landing-art{max-height:420px}.landing-parts{padding:44px 0 56px}.part-grid{grid-template-columns:1fr}.part-card{padding:22px 24px 28px}}
</style>
