---
interface Props {
  title: string;
  base: string;
  isOverview: boolean;
  currentLabel: string;
  historyHref?: string;
}

const { title, base, isOverview, currentLabel, historyHref } = Astro.props;
const collection = base.replace(/[^/]+$/, '');
---
<header class="topbar">
  <div class="header-main">
    <a class="brand" href={`${base}/`} aria-label={`${title} overview`}>
      <svg class="brand-mark" aria-hidden="true" viewBox="0 0 16 16" width="30" height="30"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></svg>
      <span class="brand-label">{title}</span>
    </a>
    {historyHref && <a class="history-link" href={historyHref}>Reading history</a>}
    <label class="theme-label">
      <svg class="theme-icon" aria-hidden="true" viewBox="0 0 20 20" width="20" height="20"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor"/><path d="M10 2.5a7.5 7.5 0 0 0 0 15Z" fill="currentColor"/></svg>
      <span class="sr-only">Color theme</span>
      <select id="theme" aria-label="Color theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>
    </label>
  </div>
  <nav class="guide-navigation" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href={collection}>All guides</a></li>
      <li class="separator" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 3 5 5-5 5"/></svg></li>
      <li>{isOverview ? <span aria-current="page">{title}</span> : <a href={`${base}/`}>{title}</a>}</li>
      {!isOverview && <>
        <li class="separator" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 3 5 5-5 5"/></svg></li>
        <li class="current-page"><span aria-current="page">{currentLabel}</span></li>
      </>}
    </ol>
  </nav>
</header>
<style>
  :global(html:root){scroll-padding-top:calc(var(--guide-header-height, 114px) + 26px)}
  .topbar{display:block;height:auto;padding:0;position:sticky;top:0;z-index:5;background:var(--header);border-bottom:1px solid var(--rule)}
  .header-main{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:10px 32px}
  .brand{display:flex;align-items:center;gap:10px;min-width:0;color:var(--ink);font-weight:700;line-height:1.3;text-decoration:none;letter-spacing:-.3px;overflow-wrap:anywhere}
  .brand-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .brand-mark{display:block;flex-shrink:0;width:30px;height:30px;fill:currentColor}
  .history-link{margin-left:auto;color:var(--body);font-size:13px;text-decoration:none;white-space:nowrap}
  .theme-label{display:flex;align-items:center;gap:8px;flex-shrink:0;color:var(--muted)}
  .theme-icon{display:block;flex-shrink:0}
  .guide-navigation{display:flex;align-items:center;min-height:48px;padding:2px 32px;border-top:1px solid var(--rule);font-size:13px;line-height:1.5}
  .breadcrumb-list{display:flex;align-items:center;gap:10px;min-width:0;margin:0;padding:0;list-style:none}
  .breadcrumb-list li{display:flex;align-items:center;min-width:0}
  .breadcrumb-list a{display:inline-flex;align-items:center;min-height:44px;font-weight:600;text-decoration:none;white-space:nowrap}
  .breadcrumb-list a:hover{text-decoration:underline}
  .breadcrumb-list [aria-current=page]{color:var(--ink);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .separator{flex-shrink:0;color:var(--muted)}
  @media(min-width:761px){
    :global(.shell > .sidebar){height:calc(100vh - var(--guide-header-height, 114px));top:var(--guide-header-height, 114px)}
  }
  @media(max-width:760px){
    :global(html:root){scroll-padding-top:calc(var(--guide-header-height, 240px) + 26px)}
    .header-main{padding:10px 18px;gap:12px}
    .brand{font-size:14px}
    .brand-mark{width:26px;height:26px}
    .guide-navigation{padding:2px 18px}
    .breadcrumb-list{flex-wrap:wrap;gap:4px 8px;padding:4px 0}
    .breadcrumb-list li{max-width:100%}
    .breadcrumb-list a{min-height:32px}
    .breadcrumb-list a,.breadcrumb-list [aria-current=page]{white-space:normal;overflow-wrap:anywhere}
  }
  @media print{.topbar{display:none}}
</style>
<script>
  const header = document.querySelector<HTMLElement>('header.topbar')!;
  function updateHeaderHeight() {
    document.documentElement.style.setProperty('--guide-header-height', `${Math.ceil(header.getBoundingClientRect().height)}px`);
  }
  updateHeaderHeight();
  if (typeof ResizeObserver === 'function') {
    new ResizeObserver(updateHeaderHeight).observe(header);
  } else {
    window.addEventListener('resize', updateHeaderHeight);
  }
</script>
