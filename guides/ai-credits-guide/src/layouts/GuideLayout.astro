---
import { getCollection, type CollectionEntry } from 'astro:content';
import Diagram from '../components/Diagram.astro';
import CreditJar from '../components/CreditJar.astro';
import { chapters, coursePath, parts } from '../course';
import Landing from '../../../../shared/Landing.astro';
import GuideHeader from '../../../../shared/GuideHeader.astro';
import landingArt from '../assets/landing.jpg';
import '../styles/global.css';

interface Props {
  page: CollectionEntry<'guide'>;
  headings: { depth: number; slug: string; text: string }[];
}
const { page, headings } = Astro.props;
const pages = await getCollection('guide');
const entryFor = (id: string) => {
  const entry = pages.find(entry => entry.id === id);
  if (!entry) throw new Error(`Missing course content: ${id}`);
  return entry;
};
const sequence = ['start', ...chapters.map(chapter => chapter.id)];
const current = sequence.indexOf(page.id);
const previous = current > 0 ? entryFor(sequence[current - 1]) : undefined;
const next = current >= 0 && current < sequence.length - 1 ? entryFor(sequence[current + 1]) : undefined;
const chapter = chapters.find(chapter => chapter.id === page.id);
const titleFor = (entry: CollectionEntry<'guide'>) => {
  const chapter = chapters.find(chapter => chapter.id === entry.id);
  return chapter ? `${chapter.number} ${entry.data.title}` : entry.id === 'start' ? 'Course index' : entry.data.title;
};
const outlineParts = parts.filter((_, index) => chapter?.kind === 'overview' && chapter.part === index + 1);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => `${base}/${coursePath(id)}${id === 'start' ? '' : '/'}`;
const stale = Date.now() - new Date(`${page.data.verified}T00:00:00Z`).getTime() > 30 * 86400000;
const titleWords = page.data.title.split(' ');
const titleEmphasis = page.id === 'start' ? titleWords.splice(-3).join(' ') : '';
const TitleTag = page.id === 'start' ? 'h2' : 'h1';
const landingParts = parts.map(part => ({
  title: part.title,
  href: href(part.pages[0]),
  description: part.pages[0].endsWith('-overview') ? entryFor(part.pages[0]).data.description : part.pages.map(id => entryFor(id).data.title).join(' · '),
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.data.description} />
    <meta name="color-scheme" content="light dark" />
    <title>{titleFor(page)}{chapter ? ` · ${chapter.partTitle}` : ''} · AI Credits</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('theme') || 'system'; } catch {}
        const dark = preference === 'dark' || (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.preference = preference;
      })();
    </script>
  </head>
  <body data-reading-guide="ai-credits-guide" data-reading-page={page.id} data-reading-page-title={titleFor(page)} data-reading-part={chapter?.part} data-reading-chapters={chapter && JSON.stringify(parts[chapter.part - 1].pages)}>
    <a class="skip" href={page.id === 'start' ? '#landing-title' : '#content'}>Skip to content</a>
    <GuideHeader title="AI Credits" base={base} isOverview={page.id === 'start'} currentLabel={titleFor(page)} historyHref={`${base.replace(/[^/]+$/, '')}history/`} />
    <div class:list={['shell', { 'landing-page': page.id === 'start' }]}>
      {page.id !== 'start' && <aside class="sidebar">
        <div class="edition">COURSE CONTENTS<span>AI credit budgeting</span></div>
        <details class="chapter-nav" open>
          <summary>Explore the course <span aria-hidden="true">⌄</span></summary>
          <nav aria-label="Guide chapters">
            <a class="course-home" href={href('start')} aria-current={page.id === 'start' ? 'page' : undefined}>Course index</a>
            {parts.map((part, index) => (
              <section class="course-part">
                <h2><span class="chapter-number">Part {index + 1}</span> {part.title}</h2>
                <div class="chapter-pages">{part.pages.map(id => {
                  const entry = entryFor(id);
                  return <a href={href(id)} aria-current={id === page.id ? 'page' : undefined}>{titleFor(entry)}</a>;
                })}</div>
              </section>
            ))}
            <div class="course-appendix"><span>Appendix</span><a href={href('sources')} aria-current={page.id === 'sources' ? 'page' : undefined}>Sources & release status</a></div>
          </nav>
        </details>
        <div class="sidebar-note">Learn the model.<br />Apply it with accountable owners.</div>
      </aside>}
      <main id="content">
        {page.id === 'start' && <Landing name="ai-credits-guide" art={landingArt} alt="Pen-and-ink illustration of a jar of coins beside an open ledger and an adding machine, resting on clouds." reviewed={page.data.verified} stale={stale} readingProgress start={href(chapters[0].id)} secondary={{ href: href('sources'), label: 'Sources & release status' }} parts={landingParts} />}
        <div class="article-grid">
          <article>
            {page.id !== 'start' && <><div class="eyebrow">{chapter ? `Part ${chapter.part}: ${chapter.partTitle}` : page.data.section}<span class="eyebrow-line"></span></div>
            <TitleTag class="page-title">{chapter && <span class="lesson-number">{chapter.number} </span>}{titleWords.join(' ')}{titleEmphasis && <> <span class="title-emphasis">{titleEmphasis}</span></>}</TitleTag>
            <p class="lede">{page.data.description}</p>
            <div class="page-meta"><span>ENTERPRISE</span><span>Reviewed {page.data.verified}</span>{stale && <strong class="status caution">Review overdue · verify against sources</strong>}</div>
            {page.data.diagram && <section class="diagram-section" aria-label="Visual explanation">
              <div class="figure-label">VISUAL LESSON</div>
              <Diagram name={page.data.diagram} />
            </section>}</>}
            {page.id === 'controls' && <CreditJar />}
            <div class="prose"><slot /></div>
            {outlineParts.length > 0 && <div class="course-outline prose">
              {outlineParts.map(part => {
                const partNumber = parts.indexOf(part) + 1;
                return <section>
                  <h2 id={`part-${partNumber}`}>{page.id === 'start' ? `Part ${partNumber}: ${part.title}` : 'Chapters in this part'}</h2>
                  <ol>{part.pages.filter(id => id !== page.id).map(id => {
                    const entry = entryFor(id);
                    return <li><a href={href(id)}>{titleFor(entry)}</a><p>{entry.data.description}</p></li>;
                  })}</ol>
                </section>;
              })}
            </div>}
            {page.data.scenarioDiagram && <section class="diagram-section" aria-label="Scenario visual">
              <div class="figure-label">APPLY THE CONCEPT</div>
              <Diagram name={page.data.scenarioDiagram} />
            </section>}
            {page.data.checks && <section class="self-check prose" aria-labelledby="check-your-understanding">
              <h2 id="check-your-understanding">Check your understanding</h2>
              <p>Try each question before opening the answer.</p>
              {page.data.checks.map(check => <details><summary>{check.question}</summary><p>{check.answer}</p></details>)}
            </section>}
            <section class="source-note" aria-labelledby="page-sources">
              <h2 id="page-sources">Sources & freshness</h2>
              <p>Source review: <time datetime={page.data.verified}>{page.data.verified}</time>. This independent guide is not a contract or a substitute for your billing settings. Source links are authoritative; recommendations are labeled as guide advice.</p>
              <ul>{page.data.sources.map((source) => <li><a href={source} target="_blank" rel="noopener noreferrer">{new URL(source).hostname} / {new URL(source).pathname.split('/').filter(Boolean).at(-1)?.replaceAll('-', ' ')} ↗</a></li>)}</ul>
            </section>
            {chapter && <span data-reading-chapter-end aria-hidden="true" style="display:block;height:1px"></span>}
            {page.id !== 'start' && <nav class="pagination" aria-label="Reading sequence">{previous ? <a rel="prev" href={href(previous.id)}><small>← PREVIOUS</small>{titleFor(previous)}</a> : <span></span>}{next ? <a class="next" rel="next" href={href(next.id)}><small>NEXT CHAPTER →</small>{titleFor(next)}</a> : <a class="next" href={href('start')}><small>{page.id === 'sources' ? 'RETURN TO COURSE →' : 'COURSE COMPLETE →'}</small>Course index</a>}</nav>}
            <footer class="article-footer">AI Credits <span>Independent guidance. Official sources, clearly linked.</span></footer>
          </article>
          {page.id !== 'start' && <aside class="toc" aria-label="On this page"><div>ON THIS PAGE</div>{headings.filter((h) => h.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}{outlineParts.map(part => <a href={`#part-${parts.indexOf(part) + 1}`}>{page.id === 'start' ? part.title : 'Chapters in this part'}</a>)}{page.data.checks && <a href="#check-your-understanding">Check your understanding</a>}<a href="#page-sources">Sources & freshness</a></aside>}
        </div>
      </main>
    </div>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme')!;
      const media = matchMedia('(prefers-color-scheme: dark)');
      const mobile = matchMedia('(max-width: 760px)');
      const navigation = document.querySelector<HTMLDetailsElement>('.chapter-nav');
      function syncNavigation() {
        if (!navigation) return;
        navigation.open = !mobile.matches;
        const sidebar = navigation.closest<HTMLElement>('.sidebar')!;
        if (!mobile.matches && sidebar.scrollHeight > sidebar.clientHeight) {
          const active = navigation.querySelector<HTMLAnchorElement>('[aria-current="page"]')!.getBoundingClientRect();
          const bounds = sidebar.getBoundingClientRect();
          if (active.top < bounds.top || active.bottom > bounds.bottom) {
            sidebar.scrollTop += active.top - bounds.top - (sidebar.clientHeight - active.height) / 2;
          }
        }
      }
      syncNavigation();
      mobile.addEventListener('change', syncNavigation);
      document.querySelectorAll<HTMLButtonElement>('[data-diagram-size]').forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', () => {
          const zoomed = button.closest('figure')!.classList.toggle('diagram-zoomed');
          button.setAttribute('aria-pressed', String(zoomed));
          button.textContent = zoomed ? 'Fit figure to screen' : 'Zoom figure';
        });
      });
      select.value = document.documentElement.dataset.preference || 'system';
      function applyTheme() {
        const preference = select.value;
        const theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.preference = preference;
        document.querySelectorAll<HTMLAnchorElement>('[data-diagram-link]').forEach((link) => {
          const url = new URL(link.href);
          url.pathname = url.pathname.replace(/\.(light|dark)\.html$/, `.${theme}.html`);
          url.hash = '';
          link.href = url.href;
        });
      }
      select.addEventListener('change', () => {
        try { localStorage.setItem('theme', select.value); } catch {}
        applyTheme();
      });
      media.addEventListener('change', applyTheme);
      applyTheme();
    </script>
    <script is:inline src={`${base}/reading-progress.js`}></script>
  </body>
</html>
