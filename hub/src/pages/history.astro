---
import { guides } from '../../../guides.mjs';
import Header from '../components/Header.astro';
import '../../../guides/ai-credits-guide/src/styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guideInfo = guides.map(({ name, title }) => ({ name, title }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Reading history · Enterprise enablement</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('theme') || 'system'; } catch {}
        const dark = preference === 'dark' || (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.preference = preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header history />
    <main id="content">
      <div class="history-page" data-history-dashboard data-guides={JSON.stringify(guideInfo)}>
        <div class="page-heading">
          <div>
            <h1>Reading <span>history</span></h1>
            <p class="intro">Your reading activity, saved in this browser on this device.</p>
          </div>
          <button type="button" id="clear-reading-history" disabled>Clear history</button>
        </div>

        <noscript><p class="notice">Enable JavaScript to see the reading history saved in this browser.</p></noscript>

        <section class="chart-card" aria-labelledby="activity-heading">
          <div class="chart-heading">
            <div>
              <h2 id="activity-heading">Reading activity</h2>
              <p id="activity-summary" role="status" aria-live="polite">When pages in your saved history were last opened.</p>
            </div>
            <div class="range-group" role="group" aria-label="Activity period">
              <button type="button" data-activity-range="90" aria-pressed="true">Last 90 days</button>
              <button type="button" data-activity-range="30" aria-pressed="false">Last 30 days</button>
              <button type="button" data-activity-range="7" aria-pressed="false">Last 7 days</button>
            </div>
          </div>
          <div class="chart-layout">
            <div class="chart-axis" aria-hidden="true"><span id="activity-peak">0</span><span>0</span></div>
            <div class="chart-content">
              <div class="chart-plot">
                <svg id="activity-chart" viewBox="0 0 1000 190" preserveAspectRatio="none" role="img" aria-label="Reading activity">
                  <defs>
                    <linearGradient id="activity-fill" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent)" stop-opacity=".34"></stop>
                      <stop offset="100%" stop-color="var(--accent)" stop-opacity=".02"></stop>
                    </linearGradient>
                  </defs>
                  <g class="chart-grid" aria-hidden="true">
                    <line x1="0" y1="12" x2="1000" y2="12"></line>
                    <line x1="0" y1="66" x2="1000" y2="66"></line>
                    <line x1="0" y1="120" x2="1000" y2="120"></line>
                    <line x1="0" y1="174" x2="1000" y2="174"></line>
                  </g>
                  <path id="activity-area" fill="url(#activity-fill)"></path>
                  <path id="activity-line" fill="none"></path>
                </svg>
                <p id="activity-empty" class="chart-empty" hidden>No saved pages in this period.</p>
              </div>
              <div class="chart-ticks" id="activity-ticks" aria-hidden="true"></div>
            </div>
          </div>
          <p class="chart-note">Each page is counted once, on its most recent visit. History keeps up to 50 pages.</p>
        </section>

        <section class="history-list" aria-labelledby="recent-heading">
          <div class="table-toolbar">
            <div class="table-tabs" role="group" aria-label="History period">
              <button type="button" data-history-period="all" aria-pressed="true">All pages <span id="history-all-count">—</span></button>
              <button type="button" data-history-period="7" aria-pressed="false">Last 7 days <span id="history-week-count">—</span></button>
            </div>
            <label class="guide-filter" for="history-guide-filter">
              <span>Guide</span>
              <select id="history-guide-filter">
                <option value="all">All guides</option>
                {guides.map(guide => <option value={guide.name}>{guide.title}</option>)}
              </select>
            </label>
          </div>
          <div class="table-heading">
            <h2 id="recent-heading">Recent pages</h2>
            <p id="reading-history-status" role="status" aria-live="polite">Your reading history will appear here as you visit a guide.</p>
          </div>
          <div class="table-frame">
            <table class="history-table">
              <caption class="sr-only">Pages saved in your reading history</caption>
              <thead><tr><th scope="col">Page</th><th scope="col">Guide</th><th scope="col">Last opened</th></tr></thead>
              <tbody id="reading-history"></tbody>
            </table>
            <p id="reading-history-empty" class="table-empty" hidden></p>
          </div>
        </section>

        <a class="back-link" href={`${base}/#guides`}>← Back to guides</a>
        <footer class="article-footer">Enterprise enablement <span>Independent guidance. Official sources, clearly linked.</span></footer>
      </div>
    </main>
    <script is:inline src={`${base}/reading-progress.js`}></script>
  </body>
</html>
<style>
  main{padding:0 44px 20px}
  .history-page{max-width:1120px;margin:0 auto;padding-top:48px;color:var(--body)}
  .page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:32px;padding-bottom:28px;border-bottom:1px solid var(--rule)}
  h1{margin:0;font-size:clamp(36px,4vw,48px);font-weight:800;line-height:1.08;letter-spacing:-.035em;color:var(--ink)}
  h1 span{color:var(--accent)}
  .intro{margin:12px 0 0;color:var(--muted);font-size:16px;line-height:1.6}
  .notice{color:var(--muted);font-size:14px}
  #clear-reading-history,.guide-filter select{border:1px solid var(--rule);border-radius:4px;background:var(--surface);color:var(--body);font:inherit;font-size:13px}
  #clear-reading-history{padding:8px 14px;cursor:pointer;white-space:nowrap}
  #clear-reading-history:hover:not(:disabled){background:var(--inset)}
  #clear-reading-history:disabled{opacity:.5;cursor:default}
  .history-page button:focus-visible,.history-page select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .chart-card{padding:24px;border:1px solid var(--rule);border-radius:4px;background:var(--surface)}
  .chart-heading,.table-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
  .chart-heading h2,.table-heading h2{margin:0;color:var(--ink);font-size:20px;letter-spacing:-.4px;line-height:1.4}
  .chart-heading p,.table-heading p{margin:4px 0 0;color:var(--muted);font-size:13px;line-height:1.5}
  .range-group,.table-tabs{display:flex;align-items:center;border:1px solid var(--rule);border-radius:4px;overflow:hidden}
  .range-group button,.table-tabs button{border:0;background:transparent;color:var(--muted);font:inherit;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}
  .range-group button{padding:8px 12px}
  .range-group button+button{border-left:1px solid var(--rule)}
  .range-group button[aria-pressed=true],.table-tabs button[aria-pressed=true]{background:var(--tint);color:var(--accent)}
  .range-group button:hover,.table-tabs button:hover{color:var(--ink)}
  .chart-layout{display:flex;gap:12px;margin-top:30px}
  .chart-axis{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end;padding:0 0 20px;color:var(--muted);font:11px/1 var(--font-mono)}
  .chart-content{min-width:0;flex:1}
  .chart-plot{position:relative;height:220px}
  #activity-chart{display:block;width:100%;height:100%;overflow:visible}
  .chart-grid line{stroke:var(--rule);stroke-width:1;opacity:.5;vector-effect:non-scaling-stroke}
  #activity-line{stroke:var(--accent);stroke-width:1.75;stroke-linejoin:round;vector-effect:non-scaling-stroke}
  .chart-empty{position:absolute;inset:0;display:grid;place-items:center;margin:0;color:var(--muted);font-size:13px}
  .chart-empty[hidden]{display:none}
  .chart-ticks{display:flex;justify-content:space-between;gap:8px;margin-top:8px;color:var(--muted);font:11px/1.3 var(--font-mono)}
  .chart-note{margin:20px 0 0;color:var(--muted);font-size:12px;line-height:1.5}
  .history-list{margin-top:32px}
  .table-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .table-tabs{background:var(--surface)}
  .table-tabs button{padding:8px 12px}
  .table-tabs button+button{border-left:1px solid var(--rule)}
  .table-tabs span{margin-left:3px;color:var(--muted);font-size:11px}
  .guide-filter{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;font-weight:600}
  .guide-filter select{max-width:200px;padding:7px 26px 7px 10px}
  .table-heading{align-items:baseline;margin:24px 0 12px}
  .table-frame{overflow:hidden;border:1px solid var(--rule);border-radius:4px;background:var(--surface)}
  .history-table{width:100%;border-collapse:collapse;text-align:left;font-size:13px;line-height:1.5}
  .history-table th{padding:12px 16px;background:var(--inset);color:var(--ink);font-weight:600}
  .history-table th:first-child{width:46%}
  .history-table th:nth-child(2){width:27%}
  :global(#reading-history tr){border-top:1px solid var(--rule)}
  :global(#reading-history td){padding:14px 16px;vertical-align:middle}
  :global(#reading-history a){color:var(--ink);font-weight:600;overflow-wrap:anywhere;text-decoration:none}
  :global(#reading-history a:hover){color:var(--link);text-decoration:underline}
  :global(#reading-history .guide-badge){display:inline-block;max-width:100%;border:1px solid var(--rule);border-radius:3px;padding:2px 8px;color:var(--muted);font-size:12px;line-height:1.5}
  :global(#reading-history time){color:var(--muted);font:11px/1.5 var(--font-mono);white-space:nowrap}
  .table-empty{margin:0;padding:40px 20px;text-align:center;color:var(--muted);font-size:13px}
  .table-empty[hidden]{display:none}
  .back-link{display:inline-block;margin-top:32px;font-size:13px}
  .article-footer{margin-top:36px}
  @media(max-width:760px){
    main{padding:0 22px 12px}.history-page{padding-top:32px}.page-heading{align-items:flex-start}
    .chart-heading{flex-direction:column}.chart-layout{margin-top:22px}.chart-plot{height:180px}
    .table-heading{flex-direction:column;gap:0}.table-toolbar{align-items:flex-start;flex-wrap:wrap}
  }
  @media(max-width:540px){
    .page-heading{flex-wrap:wrap}.chart-card{padding:19px}
    .range-group{width:100%}.range-group button{flex:1;padding:8px 5px;font-size:11px}
    :global(#activity-ticks span:nth-child(2)),:global(#activity-ticks span:nth-child(3)),:global(#activity-ticks span:nth-child(5)){display:none}
    .history-table thead{display:none}
    :global(#reading-history tr){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;padding:14px 16px}
    :global(#reading-history td){padding:0;min-width:0}
    :global(#reading-history td:first-child){grid-column:1/-1}
    :global(#reading-history time){white-space:normal;text-align:right}
  }
</style>
